   "source": [
    "class linklist:\n",
    "    def  __init__(self,val):\n",
    "        self.val = val\n",
    "        self.next = None\n",
    "\n",
    "n1 = linklist(10)\n",
    "n2 = linklist(20)\n",
    "n3 = linklist(30)\n",
    "\n",
    "n1.next = n2\n",
    "n2.next = n3\n",
    "\n",
    "head = n1\n",
    "\n",
    "curr = head\n",
    "\n",
    "while curr:\n",
    "    print(curr.val)\n",
    "    curr = curr.next"
   ]
  }
 ],
